{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": { "maxDuration": 60, "includeFiles": "public/kharis/**" }
  },
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "https://localhost" },
        { "key": "Vary", "value": "Origin" }
      ]
    },
    { "source": "/kharis/indice.json", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] },
    { "source": "/kharis/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }] }
  ],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
