# Variables de la app nativa de Android (`npm run build:android` usa el modo "android").
# La app corre desde https://localhost, asi que el backend se llama con URL absoluta.
# Poner aqui el dominio donde esta desplegado el backend (Vercel), terminado en /api.
# Vacio: la app funciona sin red (decision calculada en el telefono, chat en modo demostracion).
VITE_API_URL=https://agroresilience.app/api
