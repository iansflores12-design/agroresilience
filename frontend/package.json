{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:android": "tsc -b && vite build --mode android && cap sync android",
    "android": "npm run build:android && cap open android",
    "apk": "npm run build:android && cd android && gradlew assembleDebug",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "tema": "node --import ./scripts/registrar_resolver.mjs scripts/generar_tema.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource-variable/google-sans-flex": "^5.3.2",
    "i18next": "^27.1.2",
    "i18next-browser-languagedetector": "^8.3.0",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.1",
    "react-router-dom": "^7.18.5",
    "sileo": "^0.1.6"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@material-symbols/svg-400": "^0.49.0",
    "@material/material-color-utilities": "^0.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.1.0"
  }
}
