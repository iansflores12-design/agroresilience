# Frontend (Vite). En Vercel: VITE_API_URL=/api (mismo origen que las funciones de api/).
# Contrato: POST {VITE_API_URL}/chat con JSON { mensajes, contexto }; responde JSON { texto }.
# Sin esta variable el chat y la recomendacion funcionan sin conexion (modo demostracion y textos guardados).
# VITE_API_URL=/api

# Funciones de api/ (servidor). La clave se carga en el panel de Vercel
# (Settings > Environment Variables) o en .env.local para `vercel dev`; nunca en el repositorio
# ni con prefijo VITE_, porque eso la publicaria en el navegador.
# GEMINI_API_KEY=
# GEMINI_MODELO_DECISION=gemini-3.5-flash-lite
# GEMINI_MODELO_NORMAL=gemini-3.6-flash
# Razonamiento: MINIMAL (por defecto), LOW, MEDIUM, HIGH o ninguno
# GEMINI_RAZONAMIENTO=MINIMAL
